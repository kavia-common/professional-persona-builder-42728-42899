# Frontend (Vite) environment variables

# If your dev server is accessed via a path-prefix proxy (e.g. https://<host>/proxy/3000/),
# set this so Vite generates correct dev-client URLs (instead of /@vite/client at domain root).
# Example:
# VITE_DEV_SERVER_ORIGIN=https://vscode-internal-xxxx.cloud.kavia.ai/proxy/3000
VITE_DEV_SERVER_ORIGIN=

# Existing public vars (documented here for convenience; actual values are managed by the orchestrator)
NEXT_PUBLIC_FRONTEND_URL=
NEXT_PUBLIC_BACKEND_URL=
NEXT_PUBLIC_API_BASE=
NEXT_PUBLIC_WS_URL=
